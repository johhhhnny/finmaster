# FinMaster（价值投资大师工作站）环境变量配置文件模板
# 复制本文件为 .env 并填入您的 Gemini API Key:
# cp .env.example .env

# Google Gemini API Key (可前往 Google AI Studio 获取: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 默认使用的模型 (推荐: gemini-3.5-flash-lite / gemini-2.5-flash)
DEFAULT_GEMINI_MODEL=gemini-3.5-flash-lite
DEFAULT_TEMPERATURE=0.2

# 搜索引擎配置 (可选: auto / tavily / google / duckduckgo / none)
# auto: 智能多级调度 (优先使用 Tavily，无 Key/超限则自动回退至 Gemini 原生搜索或 DDG)
SEARCH_PROVIDER=auto

# Tavily AI Search API Key (可前往 https://tavily.com 免费注册，每月 1,000 次免费调用，彻底摆脱 Gemini 20次限制)
TAVILY_API_KEY=

# SEC EDGAR 官方披露联络邮箱 (可选，声明于 User-Agent 请求头中以完全符合 SEC 官方准则)
SEC_CONTACT_EMAIL=user@example.com
